# --- Robinhood Crypto API (https://robinhood.com/account/crypto -> API trading) ---
# Run `uv run trader keygen` to create a key pair. Paste the PUBLIC key into Robinhood,
# then put the API key Robinhood gives you and your PRIVATE key here.
RH_API_KEY=
RH_PRIVATE_KEY=

# --- AI news review (optional; get a key at https://build.nvidia.com). Skip with --no-ai ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# --- Universe & timeframe ---
SYMBOLS=BTC-USD,ETH-USD,SOL-USD
TIMEFRAME=1d            # 1d or 6h

# --- Strategy gate: only trade an asset if out-of-sample Sharpe clears this ---
MIN_OOS_SHARPE=0.5
COST_BPS=50             # assumed cost per trade side (Robinhood spread), in basis points

# --- Risk limits ---
MAX_POSITION_PCT=0.25         # max share of equity in any one coin
MAX_TOTAL_EXPOSURE_PCT=0.75   # max share of equity in crypto overall
MAX_ORDER_USD=1000            # largest single buy order
MIN_TRADE_USD=10              # ignore rebalances smaller than this
REBALANCE_THRESHOLD_PCT=0.03  # ignore drift smaller than this share of equity
DAILY_LOSS_LIMIT_PCT=0.05     # block new buys after losing this much in a day

# --- watch mode ---
WATCH_INTERVAL_MIN=5          # minutes between checks (1, 5, ...)
WATCH_REALERT_MIN=60          # re-alert about the same pending trades after this long
